# Copy to .env; this file contains no credentials or personal network addresses.
# Process environment overrides .env. Values are literal; no ${VAR} expansion.
# Optional: absolute project root (empty = checkout / executable directory).
AIHUB=
AIHUB_HOST=127.0.0.1
AIHUB_PORT=8080
# LAN address used by UI links, client config generators and deployment.
AIHUB_SERVER_IP=127.0.0.1
# Optional full URLs; empty = browser origin / AIHUB_SERVER_IP + default port.
AIHUB_PUBLIC_URL=
AIHUB_WEBUI_URL=
AIHUB_MCP_URL=
# Optional link to your own hardware visualization; empty hides it.
AIHUB_CASE_URL=

# First start asks for a token; Enter generates one. Never commit the real .env.
# Direct/noninteractive start generates a private token file when this is empty.
AIHUB_TOKEN=
AIHUB_TOKEN_FILE=token
AIHUB_ALLOW_UNAUTHENTICATED_API=false
# Set true behind an HTTPS reverse proxy. Direct HTTPS is detected automatically.
AIHUB_SECURE_COOKIES=false

# Server-side media endpoints (empty = localhost, not the browser's host).
AIHUB_COMFYUI_URL=
AIHUB_VOICE_URL=
AIHUB_MUSIC_URL=
AIHUB_THREED_URL=
AIHUB_MCP_LISTEN=
AIHUB_MCP_CORS=
AIHUB_MCP_OUTDIR=
AIHUB_MCP_THREED_OUTDIR=

# Optional runtime overrides (empty = existing Linux server defaults).
AIHUB_STATE_DIR=
AIHUB_DOWNLOADS_DIR=
AIHUB_KEYS_DIR=
AIHUB_CLOUD_CONFIG=
AIHUB_WEBHOOKS_FILE=
AIHUB_WEBHOOK_URLS=
# Fresh installations start with an empty registry and download catalog.
# Copy the examples to your own files before adding serving profiles.
AIHUB_REGISTRY=examples/registry.yaml
AIHUB_CATALOG=examples/catalog.yaml
AIHUB_SYSTEMD_DIR=
AIHUB_STATIC_FALLBACK=
HF_TOKEN=
HF_HUB_DISABLE_XET=1
HF_XET_DISABLE=1

# Deployment; invoked explicitly via make deploy or python scripts/deploy.py.
AIHUB_SSH_USER=user
AIHUB_SSH_PORT=22
AIHUB_REMOTE_DIR=/srv/ai-hub
AIHUB_SERVICE=ai-hub
AIHUB_MCP_SERVICE=ai-hub-mcp

# Optional output path for node gen-opencode.js.
AIHUB_OPENCODE_OUTPUT=
# Client generators: use the remote hub token, independently of local AIHUB_TOKEN.
# Empty file path defaults to ~/.config/ai-hub/hub-api-key.
AIHUB_CLIENT_TOKEN=
AIHUB_CLIENT_TOKEN_FILE=
