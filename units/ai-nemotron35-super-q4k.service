[Unit]
Description=Nemotron 3.5 Super VL 120B Q4_K_M :18034 (4 GPUs)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ai-nemotron35-super-q4k.sh up
ExecStop=/usr/local/sbin/ai-nemotron35-super-q4k.sh down
TimeoutStartSec=900
TimeoutStopSec=60
