[Unit]
Description=Qwen 3.8 27B Q4_K_M llama :18021 (1-4 GPU, ctx 32k-256k, parallel 1-8)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ai-qwen-q4k-llama.sh up
ExecStop=/usr/local/sbin/ai-qwen-q4k-llama.sh down
TimeoutStartSec=600
TimeoutStopSec=30
