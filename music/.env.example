# =============================================================================
# ACE-Step 1.5 — Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# These settings survive repository updates.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d
#
# =============================================================================

# --- Mode ---
# "gradio" = web UI (default)
# "api"    = REST API server
ACESTEP_MODE=gradio

# --- Port ---
GRADIO_PORT=8016
ACESTEP_API_PORT=8017

# --- Model Selection ---
# DiT model (quality/speed trade-off):
#   acestep-v15-turbo      — 2B, 8 steps, fastest (default for low VRAM)
#   acestep-v15-sft        — 2B, 50 steps, balanced
#   acestep-v15-base       — 2B, 50 steps, most diverse
#   acestep-v15-xl-turbo   — 4B, 8 steps, best quality for 24GB VRAM ★ (needs full download)
#   acestep-v15-xl-sft     — 4B, 50 steps, highest quality
#   acestep-v15-xl-base    — 4B, 50 steps, most diverse XL
# On the server: acestep-v15-turbo — the only complete DiT on disk.
ACESTEP_CONFIG_PATH=acestep-v15-turbo

# Language Model (improves lyrics, metadata, composition):
#   acestep-5Hz-lm-0.6B   — lightweight, 8GB VRAM systems
#   acestep-5Hz-lm-1.7B   — balanced, 12-16GB VRAM
#   acestep-5Hz-lm-4B     — best quality, 20GB+ VRAM ★
# On the server: acestep-5Hz-lm-1.7B (lm-4B was never downloaded).
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B

# --- LLM Backend ---
# "pt"  = PyTorch (always works, slower)
# "vllm" = nano-vllm with paged KV cache (faster, recommended for >=24GB)
ACESTEP_LLM_BACKEND=vllm

# --- Auto-init ---
# true  = download and load models on startup (slower first start)
# false = defer to UI "Initialize" button
ACESTEP_INIT_SERVICE=true

# --- Performance ---
# Enable HuggingFace fast downloads
HF_HUB_ENABLE_HF_TRANSFER=1

# Disable tokenizer parallelism warnings in containers
TOKENIZERS_PARALLELISM=false

# --- GPU Assignment  [E-02] ---
# ACE-Step needs a SINGLE dedicated GPU with >= ~18 GiB FREE VRAM
# (DiT ~15 GiB weights + LM KV cache + runtime). Do NOT run it across
# 0,1,2,3 while the LLM holds the GPUs — it will OOM or steal VRAM.
#
# ai-hub GPU map (AGENTS.md):
#   GPU 0 = ComfyUI (FLUX.2 / Wan / SDXL / LTX / MiniMax)
#   GPU 1 = Music (ACE-Step)  <-- default
#   GPU 3 = Hunyuan3D (3D)
# LLM (q4k/q8/gemma) uses all 4 GPUs when running — stop it (with permission)
# before starting music if no single GPU is free.
#
# Pre-start check (finds a GPU with enough free VRAM, prints the command):
#   ./prestart-check.sh                 # recommend
#   GPU=1 ./prestart-check.sh           # force-check a specific GPU
#   MIN_FREE_GB=20 ./prestart-check.sh  # stricter
#
# Then start with exactly one GPU:
#   MUSIC_GPUS=1 docker compose up -d music
