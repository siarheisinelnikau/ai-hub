[Unit]
Description=GLM 5.3 Flash Maya-M Derisked - Project Maya :18038
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/srv/ai/maya
ExecStart=/usr/local/sbin/ai-glm53-flash-maya-m-derisked.sh
Environment=PYTHONUNBUFFERED=1
Environment=MAYA_UPDATE_CHECK=0
KillMode=control-group
TimeoutStopSec=60
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
