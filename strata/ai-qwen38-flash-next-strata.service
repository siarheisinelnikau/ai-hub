[Unit]
Description=Qwen 3.8 Flash-Next UD-IQ4_XS - Strata :18029
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/srv/ai/strata
ExecStart=/usr/local/sbin/ai-qwen38-flash-next-strata.sh
Environment=PYTHONUNBUFFERED=1
KillMode=control-group
TimeoutStopSec=45
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
